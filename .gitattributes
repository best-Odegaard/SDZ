# ============================================================
#  换行符规范
#  本机 core.autocrlf=true 会把 LF 转成 CRLF，导致 .sh 在 Linux 上
#  执行报错（部署时踩过坑）→ 强制仓库内统一使用 LF。
# ============================================================

# 默认：仓库内一律 LF
* text=auto eol=lf

# Shell 脚本必须 LF（Linux 部署）
*.sh   text eol=lf
*.mjs  text eol=lf

# Windows 批处理必须 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.jar  binary
*.zip  binary
*.docx binary
*.xlsx binary
*.pdf  binary

# 文本文件类型标注（便于 GitHub 语言统计与 diff）
*.java text
*.vue  text
*.js   text
*.json text
*.yml  text
*.yaml text
*.xml  text
*.md   text
*.sql  text
*.css  text
*.scss text
*.html text
