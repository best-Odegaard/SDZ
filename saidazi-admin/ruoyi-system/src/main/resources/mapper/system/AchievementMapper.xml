<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AchievementMapper">

    <resultMap type="Achievement" id="AchievementResult">
        <id     property="id"                 column="id"                  />
        <result property="competitionId"      column="competition_id"      />
        <result property="competitionTitle"   column="competition_title"   />
        <result property="teamName"           column="team_name"           />
        <result property="award"              column="award"               />
        <result property="introduction"       column="introduction"        />
        <result property="members"            column="members"             />
        <result property="createTime"         column="create_time"         />
    </resultMap>

    <sql id="selectAchievementVo">
        select a.id, a.competition_id, c.title as competition_title,
               a.team_name, a.award, a.introduction, a.members, a.create_time
        from achievement a
        left join competition c on a.competition_id = c.id
    </sql>

    <select id="selectAchievementList" parameterType="Achievement" resultMap="AchievementResult">
        <include refid="selectAchievementVo"/>
        <where>
            <if test="competitionId != null">
                AND a.competition_id = #{competitionId}
            </if>
            <if test="teamName != null and teamName != ''">
                AND a.team_name like concat('%', #{teamName}, '%')
            </if>
            <if test="award != null and award != ''">
                AND a.award like concat('%', #{award}, '%')
            </if>
        </where>
        order by a.create_time desc
    </select>

    <select id="selectAchievementById" parameterType="Long" resultMap="AchievementResult">
        <include refid="selectAchievementVo"/>
        where a.id = #{id}
    </select>

    <insert id="insertAchievement" parameterType="Achievement" useGeneratedKeys="true" keyProperty="id">
        insert into achievement (
            <if test="competitionId != null">competition_id,</if>
            <if test="teamName != null">team_name,</if>
            <if test="award != null">award,</if>
            <if test="introduction != null">introduction,</if>
            <if test="members != null">members,</if>
            create_time
        )values(
            <if test="competitionId != null">#{competitionId},</if>
            <if test="teamName != null">#{teamName},</if>
            <if test="award != null">#{award},</if>
            <if test="introduction != null">#{introduction},</if>
            <if test="members != null">#{members},</if>
            sysdate()
        )
    </insert>

    <update id="updateAchievement" parameterType="Achievement">
        update achievement
        <set>
            <if test="competitionId != null">competition_id = #{competitionId},</if>
            <if test="teamName != null">team_name = #{teamName},</if>
            <if test="award != null">award = #{award},</if>
            <if test="introduction != null">introduction = #{introduction},</if>
            <if test="members != null">members = #{members},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteAchievementById" parameterType="Long">
        delete from achievement where id = #{id}
    </delete>

    <delete id="deleteAchievementByIds" parameterType="Long">
        delete from achievement where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="countAchievement" resultType="int">
        select count(1) from achievement
    </select>

</mapper>