<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DashboardMapper">

    <select id="countUser" resultType="int">
        select count(1) from `user`
    </select>

    <select id="countTeam" resultType="int">
        select count(1) from team
    </select>

    <select id="countPost" resultType="int">
        select count(1) from post
    </select>

    <select id="countCompetitionByCategory" resultType="java.util.Map">
        select ifnull(category,'未分类') as category, count(1) as count
        from competition
        group by category
        order by count desc
    </select>

</mapper>